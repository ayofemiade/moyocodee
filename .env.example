# Copy to .env.local (never commit .env.local). Values are server-only.

# Email delivery via Resend (https://resend.com). Create an API key in your Resend account.
RESEND_API_KEY=
# Where enquiries are sent. Before moyocode.com is verified in Resend,
# this must be the same email address as your Resend account.
CONTACT_TO_EMAIL=
# Optional. After verifying moyocode.com in Resend, e.g. "MoyoCode <hello@moyocode.com>".
CONTACT_FROM_EMAIL=

# Optional second channel: any webhook (automation tool, WhatsApp bridge, CRM).
CONTACT_WEBHOOK_URL=
