# Copy to .env.local (never commit .env.local). All values are server-only.
# The site sends enquiries straight from your own mailbox. No email service in between.

# Hostinger business email (once moyocode.com is bought):
#   SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465   SMTP_USER=hello@moyocode.com
# Gmail (until then; needs 2-Step Verification and an App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com       SMTP_PORT=465   SMTP_USER=you@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where enquiries land. Leave empty to send them to SMTP_USER itself.
CONTACT_TO_EMAIL=
